<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cabin+Sketch:wght@400;700&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="normalize.css">
  <link rel="stylesheet" href="style.css">
  <style>
    {% if edit %}

    [data-card] {
      cursor: move;
      user-select: none;
      touch-action: none;
    }

    [data-card]:hover {
      outline: 1px solid #2563eb;
    }

    [data-card] img {
      -webkit-user-drag: none;
      pointer-events: none;
    }

    {% endif %}

    @media print {

      html,
      body {
          height: 210mm;
          width: 297mm;
          background: #fff;
      }

      body {
          padding: 0;
      }

      .page {
          margin: 0;
          break-after: avoid;
      }
    }

    @page {
    size: A4 landscape;
    margin: 0;
    }


    .page {
        position: relative;
        height: 210mm;
        width: 297mm;
        margin: 0 auto;
        background: #fff;
        overflow: hidden;
    }
  </style>
</head>

<body>
  <div class="page">
    {% for card in cards %}
    {{ card|safe }}
    {% endfor %}
  </div>
  {% if edit %}
  <script>
    const collage = {{ title| tojson }};
    const page = document.querySelector('.page');

    function notify(type, detail = {}) {
      window.parent.postMessage({ source: 'a4-preview', type, ...detail }, window.location.origin);
    }

    document.querySelectorAll('[data-card]').forEach(card => {
      card.addEventListener('pointerdown', event => {
        event.preventDefault();
        notify('card-selected', { card: card.dataset.card });
        card.setPointerCapture(event.pointerId);
        card.style.zIndex = 1000;

        const pxPerMm = page.getBoundingClientRect().width / 297;
        const startX = event.clientX;
        const startY = event.clientY;
        const startLeft = parseFloat(card.style.left);
        const startTop = parseFloat(card.style.top);

        const move = moveEvent => {
          card.style.left = Math.round(startLeft + (moveEvent.clientX - startX) / pxPerMm) + 'mm';
          card.style.top = Math.round(startTop + (moveEvent.clientY - startY) / pxPerMm) + 'mm';
        };

        const up = async () => {
          card.removeEventListener('pointermove', move);
          card.removeEventListener('pointerup', up);
          card.style.zIndex = '';
          const position = {
            top: parseFloat(card.style.top),
            left: parseFloat(card.style.left),
          };

          try {
            const response = await fetch(
              `/api/collages/${encodeURIComponent(collage)}/cards/${encodeURIComponent(card.dataset.card)}/position`,
              {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(position),
              },
            );
            if (!response.ok) throw new Error(`Position save failed (${response.status})`);
            notify('card-moved', { card: card.dataset.card, ...position });
          } catch (error) {
            notify('save-error', { message: error instanceof Error ? error.message : String(error) });
          }
        };

        card.addEventListener('pointermove', move);
        card.addEventListener('pointerup', up);
      });
    });
  </script>
  {% endif %}
</body>

</html>
